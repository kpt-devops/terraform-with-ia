{
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform state:*)",
      "Bash(terraform import:*)",
      "Bash(./scripts/tf.sh * apply*)",
      "Bash(./scripts/tf.sh * destroy*)",
      "Bash(scripts/tf.sh * apply*)",
      "Bash(scripts/tf.sh * destroy*)",
      "mcp__aws__run_script"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/tf-check.sh"
          }
        ]
      }
    ]
  }
}
