# Copia a scripts/env/dev.env y scripts/env/prod.env (ignorados por git).
AWS_PROFILE=mi-perfil-dev
TF_VAR_region=us-east-1
TF_VAR_account_id=000000000000
# Bucket de state de ESTA cuenta (uno por cuenta). Región del bucket: TF_VAR_region salvo que definas TF_STATE_REGION.
TF_STATE_BUCKET=mi-bucket-state
